@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root { font-family: Manrope, sans-serif; color: #e8f0fb; background: #07111f; font-synthesis: none; }
* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; background: #07111f; }
button, input { font: inherit; }
button { cursor: pointer; }
.app { display: flex; min-height: 100vh; background: radial-gradient(circle at 76% 5%, rgba(20,184,166,.08), transparent 28%), #07111f; }
.sidebar { width: 250px; flex: 0 0 250px; background: rgba(8,20,36,.92); border-right: 1px solid #1b3048; padding: 24px 16px; display:flex; flex-direction:column; }
.brand { display:flex; align-items:center; gap:11px; padding: 0 12px 28px; color:#f8fbff; font-weight:800; letter-spacing:-.03em; }
.brand-mark { width:32px; height:32px; border:1px solid #25d4c5; border-radius:9px; display:grid; place-items:center; color:#25d4c5; font-family:'DM Mono'; font-size:12px; }
.brand small { display:block; color:#6e829b; font-size:9px; letter-spacing:.12em; margin-top:3px; font-weight:500; }
.nav-label { color:#536a84; font-size:10px; letter-spacing:.12em; font-weight:700; padding:18px 12px 8px; text-transform:uppercase; }
.nav-item { width:100%; border:0; background:transparent; color:#7890aa; text-align:left; padding:10px 12px; border-radius:8px; display:flex; gap:11px; align-items:center; font-size:12px; margin:2px 0; }
.nav-item:hover, .nav-item.active { color:#dffdfa; background:#102c3c; box-shadow: inset 2px 0 #25d4c5; }
.nav-item svg { width:15px; height:15px; }
.sidebar-footer { margin-top:auto; border-top:1px solid #1b3048; padding:18px 12px 0; color:#6e829b; font-size:11px; display:flex; gap:10px; align-items:center; }
.dot { width:7px; height:7px; background:#33d69a; border-radius:50%; box-shadow:0 0 12px #33d69a; }
.main { flex:1; min-width:0; }
.topbar { height:70px; border-bottom:1px solid #1b3048; display:flex; align-items:center; justify-content:space-between; padding: 0 34px; background:rgba(7,17,31,.7); }
.crumb { color:#7d91a9; font-size:12px; } .crumb strong { color:#f0f7ff; font-weight:600; margin-left:8px; }
.top-actions { display:flex; align-items:center; gap:18px; color:#70869f; } .status { font-family:'DM Mono'; font-size:10px; color:#55d4ae; border:1px solid #1e604f; padding:6px 9px; border-radius:5px; }
.icon-btn { background:transparent; color:#7890aa; border:0; padding:5px; } .avatar { width:28px; height:28px; border-radius:8px; background:#324a6b; color:#bcd2ed; display:grid; place-items:center; font-size:11px; font-weight:700; }
.content { max-width:1500px; margin:0 auto; padding:36px 34px 54px; }
.eyebrow { color:#25d4c5; font-family:'DM Mono'; font-size:10px; letter-spacing:.14em; text-transform:uppercase; margin:0 0 12px; } h1 { font-size:28px; letter-spacing:-.04em; margin:0; } .subtitle { color:#7d91a9; font-size:12px; margin:9px 0 28px; }
.grid { display:grid; gap:16px; } .kpis { grid-template-columns: repeat(4,1fr); } .two { grid-template-columns: 1.45fr 1fr; margin-top:16px; } .three { grid-template-columns: repeat(3,1fr); margin-top:16px; }
.card { background:rgba(13,31,51,.76); border:1px solid #1b3a55; border-radius:10px; padding:20px; box-shadow:0 12px 30px rgba(0,0,0,.12); } .card-title { color:#92a7bd; font-size:11px; margin:0 0 13px; font-weight:600; } .metric { font-size:26px; letter-spacing:-.05em; font-weight:700; } .metric span { font-size:11px; color:#51d5a5; margin-left:8px; letter-spacing:0; } .metric-note { color:#637b95; font-size:10px; margin-top:9px; }
.chart { height:210px; display:flex; align-items:flex-end; gap:9px; padding:16px 0 24px; border-bottom:1px solid #203b54; position:relative; } .chart::before { content:'accuracy'; position:absolute; top:5px; left:0; color:#53708b; font-size:9px; } .bar { flex:1; min-width:12px; border-radius:4px 4px 0 0; background:linear-gradient(180deg,#2ad4c4,#197e94); position:relative; } .bar.alt { background:linear-gradient(180deg,#9671f4,#4d4b9d); } .bar label { position:absolute; bottom:-19px; left:50%; transform:translateX(-50%); color:#66809a; font:9px 'DM Mono'; }
.legend { display:flex; gap:18px; margin-top:15px; color:#7e94ab; font-size:10px; } .legend i { display:inline-block; width:7px; height:7px; border-radius:2px; background:#28cdbf; margin-right:6px; } .legend i.violet { background:#8b6be8; }
.table { width:100%; border-collapse:collapse; font-size:11px; } .table th { text-align:left; color:#5f7892; font-size:9px; text-transform:uppercase; letter-spacing:.1em; padding:10px 0; border-bottom:1px solid #27415a; } .table td { padding:13px 0; border-bottom:1px solid #19324a; color:#aac0d6; } .table tr:last-child td { border-bottom:0; } .table td strong { color:#ecf5ff; font-weight:600; } .pill { border:1px solid #245d54; color:#54d4ab; background:#0d302d; padding:4px 7px; border-radius:4px; font-size:9px; }
.section-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; } .section-head h2 { font-size:14px; margin:0; letter-spacing:-.02em; } .link { color:#29d2c3; font-size:10px; background:none; border:0; } .heatmap { display:grid; grid-template-columns:repeat(10,1fr); gap:3px; margin-top:16px; } .heat { aspect-ratio:1; border-radius:2px; background:#1e4b62; } .heat:nth-child(3n) { background:#287d83; } .heat:nth-child(4n) { background:#5b5a99; } .heat:nth-child(7n) { background:#9a6fce; } .axis { display:flex; justify-content:space-between; color:#607991; font:9px 'DM Mono'; margin-top:10px; }
.class-bars { display:grid; gap:9px; } .class-row { display:grid; grid-template-columns:130px 1fr 36px; align-items:center; gap:10px; font-size:10px; color:#86a0b8; } .track { height:6px; border-radius:10px; background:#172f47; overflow:hidden; } .fill { height:100%; border-radius:10px; background:#2bcbbb; }
.mobile-menu { display:none; }
