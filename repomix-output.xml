import { classNames, type Model } from './types'

const baseUrl = import.meta.env.VITE_API_BASE_URL || ''
export const api = {
  async health() { return fetch(`${baseUrl}/health`).then((r) => r.json()) },
  async models(): Promise<Model[]> { return Promise.resolve(mockModels) },
  async classes() { return Promise.resolve(classNames) },
}

export const mockModels: Model[] = [
  { name: 'ResNet-50', version: 'v2.4.1', accuracy: 98.2, f1: 0.981, latency: 42, status: 'Production' },
  { name: 'EfficientNet-B3', version: 'v1.8.0', accuracy: 97.8, f1: 0.976, latency: 28, status: 'Production' },
  { name: 'ViT-Small', version: 'v0.9.2', accuracy: 96.9, f1: 0.967, latency: 65, status: 'Candidate' },
]
