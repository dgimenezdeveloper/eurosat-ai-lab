@media (max-width: 720px) { .sidebar { display:none; } .mobile-menu { display:block; } .topbar { padding:0 18px; } .content { padding:26px 18px 40px; } .kpis { grid-template-columns:1fr 1fr; gap:10px; } .card { padding:15px; } .class-row { grid-template-columns:100px 1fr 30px; } h1 { font-size:23px; } .status { display:none; } }
