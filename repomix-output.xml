import { StrictMode, useState } from 'react'
import { createRoot } from 'react-dom/client'
import { BarChart3, Beaker, Boxes, BrainCircuit, ChevronDown, CircleHelp, Database, FileImage, Gauge, LayoutDashboard, Menu, Microscope, Network, Settings2, Sparkles, UploadCloud } from 'lucide-react'
import { classNames, type PageKey } from './types'
import { mockModels } from './api'
import './styles.css'

const navigation: { label: PageKey; icon: typeof LayoutDashboard; group: string }[] = [
  { label: 'Dashboard', icon: LayoutDashboard, group: 'Workspace' },
  { label: 'Classification', icon: FileImage, group: 'Workspace' },
  { label: 'Models', icon: Boxes, group: 'Workspace' },
  { label: 'Analytics', icon: BarChart3, group: 'Workspace' },
  { label: 'Dataset', icon: Database, group: 'Workspace' },
  { label: 'Error Analysis', icon: Microscope, group: 'Workspace' },
  { label: 'VAE Lab', icon: Network, group: 'Research' },
  { label: 'Methodology', icon: CircleHelp, group: 'Research' },
]

function Card({ children, className = '' }: { children: React.ReactNode; className?: string }) { return <section className={`card ${className}`}>{children}</section> }
function SectionHead({ title, action }: { title: string; action?: string }) { return <div className="section-head"><h2>{title}</h2>{action && <button className="link">{action} →</button>}</div> }

function Dashboard() {
  const bars = [82, 86, 84, 91, 89, 93, 95, 92, 96, 98, 97, 98]
  return <>
    <p className="eyebrow">Overview / Production workspace</p><h1>EuroSAT AI Lab</h1><p className="subtitle">Satellite image classification research environment · Last synced 4 minutes ago</p>
    <div className="grid kpis">
      {[['98.2%', '↑ 1.4%', 'Best validation accuracy'], ['27,000', '↑ 12%', 'Labeled image samples'], ['10', 'stable', 'Active land-cover classes'], ['42ms', '↓ 8ms', 'Median inference latency']].map(([value, delta, note]) => <Card key={note}><p className="card-title">{note}</p><div className="metric">{value}<span>{delta}</span></div><p className="metric-note">Compared with previous run</p></Card>)}
    </div>
    <div className="grid two">
      <Card><SectionHead title="Training performance" action="View analytics" /><div className="chart">{bars.map((height, i) => <div className={`bar ${i % 3 === 0 ? 'alt' : ''}`} style={{ height: `${height}%` }} key={i}><label>{i + 1}</label></div>)}</div><div className="legend"><span><i />Validation accuracy</span><span><i className="violet" />Training accuracy</span></div></Card>
      <Card><SectionHead title="Class distribution" action="Explore dataset" /><div className="class-bars">{classNames.slice(0, 6).map((name, i) => <div className="class-row" key={name}><span>{name}</span><div className="track"><div className="fill" style={{ width: `${[78, 66, 59, 48, 42, 36][i]}%` }} /></div><span>{[2714, 2340, 2083, 1792, 1517, 1328][i]}</span></div>)}</div></Card>
    </div>
    <div className="grid two">
      <Card><SectionHead title="Model leaderboard" action="Compare models" /><table className="table"><thead><tr><th>Model</th><th>Accuracy</th><th>F1 score</th><th>Latency</th><th /></tr></thead><tbody>{mockModels.map((model) => <tr key={model.name}><td><strong>{model.name}</strong><br /><span style={{ color:'#5f7892', fontSize:10 }}>{model.version}</span></td><td>{model.accuracy}%</td><td>{model.f1}</td><td>{model.latency}ms</td><td><span className="pill">{model.status}</span></td></tr>)}</tbody></table></Card>
      <Card><SectionHead title="Confusion matrix" action="Open report" /><div className="heatmap">{Array.from({ length: 100 }, (_, i) => <span className="heat" key={i} style={{ opacity: .35 + ((i * 17) % 65) / 100 }} />)}</div><div className="axis"><span>AnnualCrop</span><span>Predicted class →</span><span>SeaLake</span></div></Card>
    </div>
  </>
}

function Classification() {
  const [file, setFile] = useState<string | null>(null)
  const [classified, setClassified] = useState(false)
  return <><p className="eyebrow">Inference / Single image</p><h1>Image classification</h1><p className="subtitle">Run a production model against a 64 × 64 multispectral tile.</p><div className="grid two"><Card><SectionHead title="Upload satellite tile" /><div style={{ border:'1px dashed #2b5b72', borderRadius:8, minHeight:260, display:'grid', placeItems:'center', textAlign:'center', background:'#0b2033' }}><div><UploadCloud size={31} color="#29d2c3" style={{ margin:'0 auto 12px' }} /><p style={{ fontSize:13, color:'#dbe9f7' }}>{file || 'Drop a GeoTIFF or image here'}</p><p style={{ color:'#68829a', fontSize:11 }}>PNG, JPG, or TIFF · max 20 MB</p><label className="link" style={{ cursor:'pointer' }}>Choose file<input type="file" hidden onChange={(e) => setFile(e.target.files?.[0]?.name || null)} /></label></div></div><button className="primary" onClick={() => setClassified(true)} disabled={!file} style={{ marginTop:16, width:'100%', padding:11, borderRadius:6, border:0, background:file ? '#24c8bb' : '#244052', color:file ? '#062019' : '#7890a0', fontWeight:700 }}>Classify image</button></Card><Card><SectionHead title="Inference result" /><div style={{ minHeight:260, display:'grid', placeItems:'center', textAlign:'center' }}>{classified ? <div><div style={{ color:'#29d2c3', fontFamily:'DM Mono', fontSize:11 }}>PREDICTED LABEL</div><div style={{ fontSize:28, fontWeight:800, margin:'12px 0 6px' }}>Forest</div><div style={{ color:'#54d4ab', fontSize:13 }}>98.7% confidence</div><div style={{ marginTop:24, textAlign:'left', width:260 }}>{['Forest','AnnualCrop','Residential','Pasture'].map((x,i) => <div className="class-row" key={x}><span>{x}</span><div className="track"><div className="fill" style={{ width:`${[98,1,0.5,0.2][i]}%` }} /></div><span>{[98.7, .8, .3, .2][i]}%</span></div>)}</div></div> : <div><BrainCircuit size={32} color="#55738e" /><p style={{ color:'#7088a0', fontSize:12 }}>Upload an image to see predictions</p></div>}</div></Card></div></>
}

function GenericPage({ page }: { page: PageKey }) { const data: Record<string, [string,string,string]> = { Models:['Model registry','Production models, checkpoints, and experiment candidates.','3 registered models'], Analytics:['Model analytics','Track validation performance and per-class behavior across runs.','12 training runs'], Dataset:['Dataset explorer','Browse balanced EuroSAT samples and metadata.','27,000 images'], 'Error Analysis':['Error analysis','Inspect low-confidence predictions and class confusion clusters.','184 flagged samples'], 'VAE Lab':['VAE Lab','Latent space exploration and generative reconstruction experiments.','Experiment status'], Methodology:['Methodology','A clear record of datasets, preprocessing, and evaluation protocol.','v1.4 protocol'] }; const [title, subtitle, badge] = data[page] || ['Workspace','Research workspace','Ready']; return <><p className="eyebrow">Research / {page}</p><h1>{title}</h1><p className="subtitle">{subtitle}</p><Card><div style={{ display:'flex', alignItems:'center', gap:14, padding:'20px 0' }}><Sparkles color="#29d2c3" /><div><h2 style={{ margin:0, fontSize:16 }}>{badge}</h2><p style={{ color:'#7189a2', fontSize:12, marginBottom:0 }}>Connect the FastAPI service to populate this workspace with live results.</p></div></div></Card><div className="grid three"><Card><p className="card-title">Latest status</p><div className="metric" style={{ fontSize:22 }}>Operational</div><p className="metric-note">API adapter is ready</p></Card><Card><p className="card-title">Last updated</p><div className="metric" style={{ fontSize:22 }}>4m ago</div><p className="metric-note">Automatic refresh enabled</p></Card><Card><p className="card-title">Environment</p><div className="metric" style={{ fontSize:22 }}>Research</div><p className="metric-note">EuroSAT / Sentinel-2</p></Card></div></> }

function App() { const [page, setPage] = useState<PageKey>('Dashboard'); const [mobileOpen, setMobileOpen] = useState(false); return <div className="app"><aside className={`sidebar ${mobileOpen ? 'open' : ''}`}><div className="brand"><div className="brand-mark">ES</div><div>EUROSAT <small>AI RESEARCH LAB</small></div></div>{['Workspace','Research'].map(group => <div key={group}><div className="nav-label">{group}</div>{navigation.filter(n => n.group === group).map(({ label, icon: Icon }) => <button className={`nav-item ${page === label ? 'active' : ''}`} key={label} onClick={() => { setPage(label); setMobileOpen(false) }}><Icon />{label}</button>)}</div>)}<div className="sidebar-footer"><span className="dot" />API connected <Settings2 size={14} style={{ marginLeft:'auto' }} /></div></aside><main className="main"><header className="topbar"><div className="crumb"><button className="icon-btn mobile-menu" onClick={() => setMobileOpen(!mobileOpen)}><Menu size={18} /></button><span style={{ marginLeft:10 }}>Research workspace /</span><strong>{page}</strong></div><div className="top-actions"><span className="status">● SYSTEMS NOMINAL</span><button className="icon-btn"><Gauge size={16} /></button><button className="icon-btn"><ChevronDown size={15} /></button><div className="avatar">AK</div></div></header><div className="content">{page === 'Dashboard' ? <Dashboard /> : page === 'Classification' ? <Classification /> : <GenericPage page={page} />}</div></main></div> }

export default App

const root = document.getElementById('root')

if (root) {
  createRoot(root).render(
    <StrictMode>
      <App />
    </StrictMode>,
  )
}
</file>

